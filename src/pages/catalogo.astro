---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { R } from '../utils/ruta';
import { CATEGORIAS, PRODUCTOS } from '../data/tienda';

// Catálogo completo: todas las piezas, agrupadas por categoría
const grupos = CATEGORIAS.map((c) => ({ ...c, productos: PRODUCTOS.filter((p) => p.categoria === c.nombre) }))
  .filter((g) => g.productos.length > 0);

const url = new URL(R('/catalogo'), Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Catálogo MERAV',
      url,
      inLanguage: 'es-CO',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: PRODUCTOS.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: p.nombre,
          url: new URL(R(`/productos/${p.slug}`), Astro.site).toString(),
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(R('/'), Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Catálogo', item: url },
      ],
    },
  ],
};
---
<Base
  title="Catálogo de tiaras, diademas y tocados | MERAV"
  description="Todas las tiaras, diademas, tocados y accesorios para novia de MERAV, hechos a mano en Colombia. Personaliza el color y pide por WhatsApp."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Header solido />

  <main class="contenedor catalogo">
    <nav class="ruta" aria-label="Ruta">
      <a href={R('/')}>Inicio</a> / <span>Catálogo</span>
    </nav>

    <header class="cabecera-cat">
      <span class="eyebrow">Catálogo</span>
      <h1>Todas nuestras piezas</h1>
      <p>Tiaras, diademas, tocados y accesorios hechos a mano en Colombia. Cada pieza puede personalizarse en el color que prefieras.</p>
      <nav class="saltos" aria-label="Ir a una categoría">
        {grupos.map((g) => <a href={`#${g.slug}`}>{g.nombre}</a>)}
      </nav>
    </header>

    {grupos.map((g) => (
      <section class="grupo" id={g.slug} aria-labelledby={`t-${g.slug}`}>
        <div class="grupo-cabecera">
          <h2 id={`t-${g.slug}`}>{g.nombre}</h2>
          <a class="enlace-linea" href={R(`/${g.slug}`)}>Ver colección <span aria-hidden="true">→</span></a>
        </div>
        <div class="rejilla-4">
          {g.productos.map((p) => <TarjetaProducto producto={p} />)}
        </div>
      </section>
    ))}
  </main>
</Base>

<style>
  .catalogo { padding-top: 28px; padding-bottom: 112px; }
  .ruta { font-size: 14px; letter-spacing: 0.04em; color: #4a4846; margin-bottom: 36px; }
  .ruta a { color: #4a4846; }
  .ruta span { color: var(--tinta); }
  .cabecera-cat { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; margin-bottom: 40px; }
  .cabecera-cat h1 { font-size: clamp(34px, 4.4vw, 52px); }
  .cabecera-cat p { margin: 0; max-width: 620px; font-size: 17px; line-height: 1.75; color: #3d3b39; }
  .saltos { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 26px; margin-top: 8px; }
  .saltos a { font-size: 13px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; padding: 10px 0; border-bottom: 1px solid transparent; }
  .saltos a:hover { border-bottom-color: var(--dorado); }
  .grupo { padding-top: 56px; }
  .grupo + .grupo { margin-top: 24px; border-top: 1px solid var(--linea); }
  .grupo-cabecera { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 28px; }
  .grupo-cabecera h2 { font-size: clamp(28px, 3vw, 38px); }
</style>
