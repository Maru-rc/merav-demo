---
import { R } from '../utils/ruta';
import IconoWhatsApp from './IconoWhatsApp.astro';
import { INSTAGRAM, waLink } from '../data/tienda';
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="contenedor columnas">
    <div class="marca">
      <span class="nombre">MERAV</span>
      <span class="sub">Tocados &amp; diademas</span>
      <p>Hecho a mano en Colombia.<br />Envíos a todo el mundo.</p>
      <div class="redes">
        <a href={INSTAGRAM} aria-label="Instagram de MERAV">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"></circle></svg>
        </a>
        <a href={waLink('Hola MERAV')} aria-label="WhatsApp de MERAV"><IconoWhatsApp size={18} /></a>
      </div>
    </div>
    <div class="enlaces">
      <div>
        <h2>Tienda</h2>
        <a href={R('/tiaras')}>Tiaras</a>
        <a href={R('/diademas')}>Diademas</a>
        <a href={R('/tocados')}>Tocados</a>
        <a href={R('/accesorios')}>Accesorios</a>
      </div>
      <div>
        <h2>MERAV</h2>
        <a href={R('/#historia')}>Nuestra historia</a>
        <a href={R('/#novias')}>Novias MERAV</a>
        <a href={R('/#novias')}>Blog</a>
      </div>
      <div>
        <h2>Ayuda</h2>
        <a href={waLink('Hola MERAV, quisiera información sobre los envíos')} target="_blank" rel="noopener">Envíos</a>
        <a href={waLink('Hola MERAV, ¿cómo debo cuidar mi pieza?')} target="_blank" rel="noopener">Cuidado de tu pieza</a>
        <a href={waLink('Hola MERAV, tengo una pregunta sobre sus piezas')} target="_blank" rel="noopener">Preguntas frecuentes</a>
        <a href={waLink('Hola MERAV, quisiera recibir el catálogo de piezas y precios')} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </div>
  <div class="contenedor legal">
    <span>© {anio} MERAV</span>
    <span><a href={R('/')}>Términos</a><a href={R('/')}>Privacidad</a></span>
  </div>
</footer>

<style>
  .pie { background: var(--verde-oscuro); color: #e9e3d6; }
  .columnas { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 48px; padding-top: 72px; padding-bottom: 48px; }
  .marca { display: flex; flex-direction: column; gap: 6px; }
  .nombre { font-family: var(--serif); font-size: 32px; letter-spacing: 0.34em; line-height: 1; color: var(--crema); }
  .sub { font-size: 9px; letter-spacing: 0.42em; text-transform: uppercase; color: var(--dorado); }
  .marca p { font-size: 15px; margin: 12px 0 0; }
  .redes { display: flex; gap: 4px; margin-left: -12px; }
  .redes a { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: #d9d2c4; }
  .enlaces { display: flex; flex-wrap: wrap; gap: 40px 72px; }
  .enlaces div { display: flex; flex-direction: column; }
  .enlaces h2 { font-family: var(--sans); font-weight: 500; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dorado); margin-bottom: 10px; }
  .enlaces a { color: #e9e3d6; text-decoration: none; font-size: 15px; padding: 6px 0; }
  .enlaces a:hover, .legal a:hover { color: var(--dorado); }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 22px; padding-bottom: 26px; border-top: 1px solid rgba(217, 210, 196, 0.18); font-size: 13px; color: #cfc7b8; }
  .legal span { display: flex; gap: 24px; }
  .legal a { color: #cfc7b8; text-decoration: none; }
</style>
