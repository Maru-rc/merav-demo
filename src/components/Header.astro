---
import { R } from '../utils/ruta';
import { waLink } from '../data/tienda';

interface Props {
  solido?: boolean;
}
const { solido = false } = Astro.props;
// "Contacto" abre WhatsApp directamente con un mensaje pidiendo el catálogo
const contacto = waLink('Hola MERAV, quisiera recibir el catálogo de piezas y precios, por favor.');
---
<header class:list={['cabecera', { solido }]}>
  <div class="barra">
    <button class="menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-principal">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
    </button>

    <!-- En escritorio el menú se reparte a los dos lados del logo -->
    <nav id="menu-principal" class="menu" aria-label="Principal">
      <div class="grupo grupo-izq">
        <a href={R('/#colecciones')}>Colecciones</a>
        <a href={R('/#tienda')}>Tienda</a>
      </div>
      <div class="grupo grupo-der">
        <a href={R('/#novias')}>Novias</a>
        <a href={contacto} target="_blank" rel="noopener">Contacto</a>
      </div>
    </nav>

    <a href={R('/')} class="logo" aria-label="MERAV, inicio">
      <span class="logo-nombre">MERAV</span>
      <span class="logo-sub">Tocados &amp; diademas</span>
    </a>
  </div>
</header>

<style>
  /* Barra de navegación sticky: transparente sobre la portada, verde al bajar */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 40;
    color: var(--crema);
    transition: background-color .4s ease, box-shadow .4s ease, border-color .4s ease;
    border-bottom: 1px solid transparent;
  }
  .cabecera.solido,
  .cabecera.fija {
    background: var(--verde);
    border-bottom-color: rgba(201, 164, 106, 0.25);
    box-shadow: 0 8px 30px rgba(10, 16, 10, 0.25);
  }
  .barra {
    position: relative;
    max-width: 1320px;
    height: var(--alto-cabecera);
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .menu { display: contents; }
  .grupo { display: flex; gap: 36px; grid-row: 1; }
  .grupo-izq { grid-column: 1; justify-content: flex-end; }
  .grupo-der { grid-column: 3; justify-content: flex-start; }
  .logo { grid-column: 2; grid-row: 1; padding: 0 28px; }
  .menu a {
    position: relative;
    color: var(--crema);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 12px 0;
  }
  /* subrayado dorado que crece al pasar el mouse */
  .menu a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 6px;
    height: 1px;
    background: var(--dorado);
    transform: scaleX(0);
    transition: transform .35s ease;
  }
  .menu a:hover { color: var(--dorado); }
  .menu a:hover::after { transform: scaleX(1); }
  .logo { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--crema); }
  .logo-nombre { font-family: var(--serif); font-size: 34px; letter-spacing: 0.34em; line-height: 1; padding-left: 0.34em; }
  .logo-sub { font-size: 9px; letter-spacing: 0.42em; text-transform: uppercase; margin-top: 6px; color: var(--dorado); }
  .menu-btn {
    display: none;
    width: 44px; height: 44px;
    background: none; border: 0; color: var(--crema); cursor: pointer;
    align-items: center; justify-content: center;
  }

  @media (max-width: 860px) {
    .barra { grid-template-columns: 44px 1fr 44px; padding: 0 16px; gap: 8px; }
    .menu-btn { display: flex; grid-column: 1; grid-row: 1; }
    .logo { padding: 0; }
    .logo-nombre { font-size: 26px; }
    .menu {
      display: none;
      position: absolute;
      top: 100%; left: 0; right: 0;
      flex-direction: column;
      padding: 8px 24px 20px;
      background: var(--verde-oscuro);
      border-top: 1px solid rgba(243, 238, 228, 0.12);
    }
    .menu.abierto { display: flex; }
    .grupo { flex-direction: column; gap: 0; }
    .menu a { padding: 14px 0; border-bottom: 1px solid rgba(243, 238, 228, 0.1); }
    .menu a::after { display: none; }
  }
</style>

<script>
  const cabecera = document.querySelector<HTMLElement>('.cabecera');
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('menu-principal');

  btn?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('abierto') ?? false;
    btn.setAttribute('aria-expanded', String(abierto));
  });
  // cerrar el menú del celular al elegir una opción
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.remove('abierto');
      btn?.setAttribute('aria-expanded', 'false');
    })
  );

  // fondo verde cuando se baja por la página
  const revisar = () => cabecera?.classList.toggle('fija', window.scrollY > 24);
  revisar();
  window.addEventListener('scroll', revisar, { passive: true });
</script>
